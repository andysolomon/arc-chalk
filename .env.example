# Public client identifiers only. Never commit credentials or private keys.
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Server-only values are configured in the relevant deployment environment.
# Clerk JWT issuer domain for Convex auth.config.ts (e.g. https://verb-noun-00.clerk.accounts.dev).
# Create a Clerk JWT template named "convex" with audience "convex".
CLERK_JWT_ISSUER_DOMAIN=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=

# Cloud coding agents should use an isolated Convex development deployment:
# CONVEX_AGENT_MODE=anonymous
# Development uses `npx convex dev`. Never use `npx convex deploy` except for production.

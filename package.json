{
  "name": "chalk",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "bun@1.2.19",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run typecheck && bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:parity": "playwright test --config tests/parity/playwright.config.ts",
    "capture:parity": "bun run test:parity --update-snapshots",
    "lint": "eslint apps packages convex scripts tests --max-warnings=0",
    "format": "prettier --write apps packages convex scripts tests package.json tsconfig.json tsconfig.base.json eslint.config.js vitest.config.ts .releaserc.json",
    "format:check": "prettier --check apps packages convex scripts tests package.json tsconfig.json tsconfig.base.json eslint.config.js vitest.config.ts .releaserc.json",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check": "bun run format:check && bun run lint && bun run check:boundaries && bun run test && bun run test:e2e && bun run test:parity && bun run build",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci"
  },
  "dependencies": {
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-virtual": "^3.14.10",
    "convex": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@semantic-release/commit-analyzer": "latest",
    "@semantic-release/github": "latest",
    "@semantic-release/release-notes-generator": "latest",
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "conventional-changelog-conventionalcommits": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "fast-check": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "semantic-release": "latest",
    "tailwindcss": "latest",
    "typescript": "5.9.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "vitest": "latest"
  }
}
